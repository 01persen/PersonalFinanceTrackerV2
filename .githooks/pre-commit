#!/usr/bin/env bash
# Personal Finance Tracker — pre-commit quality gate (local enforcement)
# Runs lint + typecheck + test only for changed apps (api / web).
# Hook ini adalah enforcement utama; GitHub Actions hanya advisory.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

# Skip kalau cuma docs / config
if echo "$STAGED_FILES" | grep -qE '\.(md|mdx|txt|yml|yaml|json|lock)$'; then
  HAS_DOCS_ONLY="true"
else
  HAS_DOCS_ONLY="false"
fi

run_api=false
run_web=false

if echo "$STAGED_FILES" | grep -qE '^apps/api/'; then
  run_api=true
fi
if echo "$STAGED_FILES" | grep -qE '^apps/web/'; then
  run_web=true
fi

# Selalu jalankan jika ada perubahan di apps/, atau jika lockfile berubah
if echo "$STAGED_FILES" | grep -qE '^(apps/api/|apps/web/|\.husky/|\.githooks/)'; then
  :
fi

echo "==> Pre-commit: detecting changes..."
echo "    apps/api: $run_api"
echo "    apps/web: $run_web"

# Jika tidak ada perubahan di apps/ dan hanya docs, skip heavy checks
if [ "$run_api" = false ] && [ "$run_web" = false ]; then
  echo "==> No changes in apps/; skip quality checks."
  exit 0
fi

# === apps/api checks ===
if [ "$run_api" = true ]; then
  echo ""
  echo "==> [api] uv sync --extra dev --frozen"
  (cd apps/api && uv sync --extra dev --frozen)

  echo "==> [api] ruff check"
  (cd apps/api && uv run ruff check .)

  echo "==> [api] mypy src"
  (cd apps/api && uv run mypy src)

  echo "==> [api] pytest"
  (cd apps/api && uv run pytest -q)
fi

# === apps/web checks ===
if [ "$run_web" = true ]; then
  echo ""
  echo "==> [web] npm ci"
  (cd apps/web && npm ci --no-audit --no-fund)

  echo "==> [web] lint"
  (cd apps/web && npm run lint)

  echo "==> [web] typecheck"
  (cd apps/web && npm run typecheck)

  echo "==> [web] build"
  (cd apps/web && NEXT_TELEMETRY_DISABLED=1 npm run build)
fi

echo ""
echo "==> Pre-commit: all checks passed."
exit 0